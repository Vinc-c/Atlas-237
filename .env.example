# ============================================================================
# CLIENT-SIDE — set these in Cloudflare Pages → Settings → Environment
# variables. They are inlined into the public JS bundle at build time, so
# ONLY put public/publishable keys here. Never put a secret key on this list.
# ============================================================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Flutterwave (payment) — public key only
VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST-your-public-key

# Paystack (payment) — public key only
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key

# ============================================================================
# SERVER-SIDE — these are NEVER read from Cloudflare/VITE_ vars. Set them as
# Supabase Edge Function secrets instead:
#   supabase secrets set FLW_SECRET_KEY=FLWSECK_TEST-...
# or via the Supabase dashboard → Project Settings → Edge Functions → Secrets.
# A payment PSP shows "no payment method available" on /app/billing until
# its secret(s) below are set — that is the ONLY reason, not a bug: each PSP
# in src/lib/psp.ts only appears once it can prove it is really configured.
# ============================================================================

# Flutterwave — used by supabase/functions/flutterwave-verify
# FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key

# Paystack — used by supabase/functions/paystack-verify
# PAYSTACK_SECRET_KEY=sk_test_your-secret-key

# PayUnit (Mobile Money: MTN, Orange, Express Union, YUP) — used by
# supabase/functions/payunit-initialize, payunit-verify, payunit-webhook
# PAYUNIT_API_USER=
# PAYUNIT_API_PASSWORD=
# PAYUNIT_API_KEY=
# PAYUNIT_MODE=test   # switch to "live" when going to production

# Transactional email — used by supabase/functions/send-ticket-notification
# RESEND_API_KEY=

# Free-tier fallback AI provider — used by supabase/functions/ai-assistant
# GEMINI_API_KEY=

# OAuth app integrations — used by supabase/functions/oauth-exchange
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=

# Present automatically in every Supabase Edge Function — no need to set
# these yourself: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
