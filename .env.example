# ============================================================================
# CLIENT-SIDE — set these in Cloudflare Pages → Settings → Environment
# variables. They are inlined into the public JS bundle at build time, so
# ONLY put public/publishable keys here. Never put a secret key on this list.
# ============================================================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Flutterwave (payment) — public key only
VITE_FLW_PUBLIC_KEY=FLWPUBK_TEST-your-public-key

# Paystack (payment) — public key only
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key

# Paddle (payment, Merchant of Record — handles global tax/VAT itself) —
# the client-side token is already set as a default in src/lib/paddle.ts
# (safe to hardcode, it's the public/client-side one, not the secret).
# Still needed before Paddle appears as a payment option: create the 4
# prices in Paddle's dashboard (Catalog → Prices), one per plan, and set
# their IDs below.
VITE_PADDLE_ENVIRONMENT=production   # set to "sandbox" only for testing
VITE_PADDLE_PRICE_STARTER=pri_your-starter-price-id
VITE_PADDLE_PRICE_GROWTH=pri_your-growth-price-id
VITE_PADDLE_PRICE_PRO=pri_your-pro-price-id
VITE_PADDLE_PRICE_ENTERPRISE=pri_your-enterprise-price-id

# ============================================================================
# SERVER-SIDE — these are NEVER read from Cloudflare/VITE_ vars. Set them as
# Supabase Edge Function secrets instead:
#   supabase secrets set FLW_SECRET_KEY=FLWSECK_TEST-...
# or via the Supabase dashboard → Project Settings → Edge Functions → Secrets.
# A payment PSP shows "no payment method available" on /app/billing until
# its secret(s) below are set — that is the ONLY reason, not a bug: each PSP
# in src/lib/psp.ts only appears once it can prove it is really configured.
# ============================================================================

# Flutterwave — used by supabase/functions/flutterwave-verify
# FLW_SECRET_KEY=FLWSECK_TEST-your-secret-key

# Paystack — used by supabase/functions/paystack-verify
# PAYSTACK_SECRET_KEY=sk_test_your-secret-key

# Paddle — used by supabase/functions/paddle-verify
# PADDLE_API_KEY=your-paddle-api-key
# PADDLE_ENVIRONMENT=sandbox   # switch to "production" when going live (must match VITE_PADDLE_ENVIRONMENT)

# PayUnit (Mobile Money: MTN, Orange, Express Union, YUP) — used by
# supabase/functions/payunit-initialize, payunit-verify, payunit-webhook
# PAYUNIT_API_USER=
# PAYUNIT_API_PASSWORD=
# PAYUNIT_API_KEY=
# PAYUNIT_MODE=test   # switch to "live" when going to production

# Transactional email — used by supabase/functions/send-ticket-notification
# RESEND_API_KEY=

# Free-tier fallback AI provider — used by supabase/functions/ai-assistant
# GEMINI_API_KEY=

# OAuth app integrations — used by supabase/functions/oauth-exchange.
# Each one also needs its matching PUBLIC client id exposed to the client
# build as VITE_<PROVIDER>_CLIENT_ID (see src/pages/IntegrationPages.tsx,
# OAUTH_CLIENT_IDS) — add that to the CLIENT-SIDE section above once you
# register the app. The secret below stays server-only, always.
# GOOGLE_CLIENT_ID=            # covers gmail, google_meet, google_calendar, google_ads, google_drive
# GOOGLE_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=         # covers outlook, microsoft_teams
# MICROSOFT_CLIENT_SECRET=
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# GOCARDLESS_CLIENT_ID=
# GOCARDLESS_CLIENT_SECRET=
# REVOLUT_CLIENT_ID=
# REVOLUT_CLIENT_SECRET=
# INTERCOM_CLIENT_ID=
# INTERCOM_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=          # covers facebook_messenger, instagram_dm, meta_ads
# FACEBOOK_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# DROPBOX_CLIENT_ID=
# DROPBOX_CLIENT_SECRET=
# DOCUSIGN_CLIENT_ID=
# DOCUSIGN_CLIENT_SECRET=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# ASANA_CLIENT_ID=
# ASANA_CLIENT_SECRET=
# TRELLO — uses Trello's own implicit token flow (not this function); its
# VITE_TRELLO_CLIENT_ID ("key") is the only credential it needs.

# Present automatically in every Supabase Edge Function — no need to set
# these yourself: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
